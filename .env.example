NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://dhis_sync:dhis_sync@localhost:5433/dhis_sync
REDIS_URL=redis://localhost:6380
# Generate with: openssl rand -base64 32
CONNECTION_ENCRYPTION_KEY=REPLACE_WITH_A_BASE64_ENCODED_32_BYTE_KEY
WEB_ORIGIN=http://localhost:5173
# Signs dashboard session tokens. Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
AUTH_TOKEN_TTL_HOURS=12
# The first account created always succeeds and becomes the admin; set false to
# close self-service sign-up to everyone after that.
AUTH_ALLOW_SIGNUP=true
VITE_API_URL=http://localhost:4000/api/v1
